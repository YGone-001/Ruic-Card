# Adapted from:
# https://github.com/HRuiCcc/RuiC-card-skill/blob/main/.gitignore
#
# Unlike the skill repository, this repository is a generated card project.
# Its PNG/JPG artwork, GLB models, and final .blend files are runtime/source
# assets, so the upstream catch-all media rules are intentionally omitted.

# Python
__pycache__/
*.py[cod]
.venv/
venv/
tools/*-env/

# Node
node_modules/

# Local configuration and OS/editor files
.env
.env.*
.DS_Store
Thumbs.db
.idea/
.vscode/

# Downloaded toolchains and archives
**/tools/blender-*/
**/tools/blender-*.sha256
*.zip

# Generated backups and diagnostics
*.blend1
*.log
gen/
**/renders/
**/verification/
**/verification.json
**/asset-validation.json
**/preview-composite.png

# Per-card web exports duplicate the multi-card site in /web and can be
# regenerated by the RuiC Card pipeline.
cards/*/web/

# Temporary source-analysis images; keep the actual references and plates.
cards/*/source/*-debug.*
cards/*/source/*-mask.*
cards/*/source/*-grid.*
